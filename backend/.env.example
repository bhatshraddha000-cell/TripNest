# Backend Environment Variables Reference Template
SPRING_PROFILES_ACTIVE=prod
PORT=8081

# Render PostgreSQL Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://<render-db-host>:5432/<dbname>
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# JWT Authentication Secret
JWT_SECRET=your-secure-production-jwt-secret-key-here-at-least-32-chars

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://<render-frontend-domain>.onrender.com,http://localhost:5173

# Cloudinary Integration (Backend Only)
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# SMTP / JavaMailSender Credentials
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-email@gmail.com>
MAIL_PASSWORD=<your-app-password>
MAIL_FROM=<your-email@gmail.com>
